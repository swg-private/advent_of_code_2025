cabal-version:      2.4
name:               day04
version:            0.1.0.0

executable day04
    main-is:          day04.hs
    other-modules:    AoC.Common,
                      AoC.Common.Runner,
                      AoC.Common.Output,
                      AoC.Day04.PaperRolls
    build-depends:    base ^>=4.17.0.0,
                      vector ^>= 0.13.2.0,
                      mtl ^>= 2.2.2
    hs-source-dirs:   src, ../common/src
    default-language: Haskell2010

test-suite test-day04
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test, src
    main-is:          day04-test.hs
    other-modules:    AoC.Day04.PaperRolls,
                      AoC.Day04.PaperRollsTest
    build-depends:    base ^>=4.17.0.0,
                      vector ^>= 0.13.2.0,
                      mtl ^>= 2.2.2,
                      HUnit
    default-language: Haskell2010